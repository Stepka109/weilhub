# =============================================================================
# WeilHub – proměnné prostředí
# Zkopírujte do .env.local (lokálně) nebo nastavte v Project Settings na Vercelu.
# Soubor .env.local NIKDY necommitujte.
# =============================================================================

# --- Veřejné (smí být v prohlížeči; data chrání Row Level Security) -----------
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
# (Starší projekty: místo toho lze použít NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Veřejná adresa aplikace (odkazy v e-mailech – potvrzení účtu, obnova hesla)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- TAJNÉ – pouze server, nikdy s prefixem NEXT_PUBLIC_ ----------------------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)
# Používá se jen v administraci pro zobrazení e-mailů a mazání účtů.
# Bez něj aplikace funguje, jen tyto dvě funkce nebudou dostupné.
SUPABASE_SECRET_KEY=

# --- Pouze pro E2E testy (testovací projekt, ne produkce!) --------------------
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
